# Schedule for the self-healing preflight — doctor.sh --fix every 5 minutes,
# starting 2 minutes after boot (nemoclaw-doctor.service has the install
# steps: sudo ./deploy/scripts/install-selfheal.sh).
[Unit]
Description=Run the NemoClaw demo preflight self-heal periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
