# Schedule for the inference-proxy watchdog — every 60s, starting 30s after
# boot (early enough that a boot-race nginx failure is recovered before the
# agent's own 1-minute cron safety net burns a second cycle on it).
[Unit]
Description=Run the NemoClaw inference-proxy watchdog every minute

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Persistent=true

[Install]
WantedBy=timers.target
