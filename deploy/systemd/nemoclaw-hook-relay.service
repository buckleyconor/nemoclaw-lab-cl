# Wake-hook relay (ADR-011) as a SYSTEM service — survives reboots (a bare
# `make hook-relay` nohup does not) and self-restarts on crash. Installed by
# deploy/scripts/install-selfheal.sh (substitutes the __NEMOCLAW_*__
# placeholders, runs as the lab user):
#
#   sudo ./deploy/scripts/install-selfheal.sh      (or: sudo make install-selfheal)
#
# HOOK_RELAY_PORT is substituted from .env's OPENCLAW_HOOK_URL (the relay
# must match the port the sandbox forward actually uses — `nemoclaw
# <sandbox> status`). Note: the relay only bridges to openshell's loopback
# SSH forward — if the sandbox forward itself died (reboot), the doctor timer
# (or: `nemoclaw <sandbox> recover`) restores it.
[Unit]
Description=NemoClaw wake-hook relay (docker bridge -> openshell loopback forward)
After=network-online.target docker.service

[Service]
Type=simple
User=__NEMOCLAW_USER__
Group=__NEMOCLAW_USER__
WorkingDirectory=__NEMOCLAW_REPO__
Environment=HOME=__NEMOCLAW_HOME__
Environment=PATH=__NEMOCLAW_HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOOK_RELAY_PORT=__NEMOCLAW_HOOK_PORT__
ExecStart=/usr/bin/env python3 __NEMOCLAW_REPO__/deploy/scripts/hook-relay.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
