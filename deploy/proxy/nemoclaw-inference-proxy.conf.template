# Agent-host inference proxy (ADR-014) — template rendered by
# deploy/scripts/run-inference-proxy.sh; do not edit the rendered copy under
# /etc/nginx/conf.d/, re-render instead.
#
# Purpose: the sandboxed agent may only egress to host.openshell.internal
# (the one host NemoClaw policy presets may pin, policy guard #6073), and the
# inference SSRF guard refuses private/internal endpoints — but exempts that
# alias. So the sandbox speaks plain HTTP to this listener on the agent host,
# and nginx carries the traffic to the lab's shared inference endpoint:
#
#   sandbox → http://host.openshell.internal:${LLM_PROXY_PORT}/v1/... → ${LLM_BASE_URL}/...
#
# The /v1/ prefix is stripped and replaced by the upstream base URL's own path,
# so the sandbox-facing URL stays stable when the lab endpoint moves (that is
# what makes `make repoint-llm` a reload instead of a re-onboard).
#
# Listeners bind loopback (host-side probes) plus ${BRIDGE_IP}, which
# run-inference-proxy.sh defaults to 0.0.0.0 — i.e. ALL interfaces. That is
# deliberate: OpenShell puts the sandbox on its own bridge network (not
# docker0), so host.openshell.internal resolves to an address that is not
# known ahead of time, and a specific-IP bind also fails at boot before Docker
# has assigned it. Set BRIDGE_IP=<ip> when you know the address and want a
# single-interface bind.
#
# Consequence to be aware of on a host with a public NIC: this listener has NO
# auth of its own — what it does is translate the credential a caller already
# presented (see the auth translation below). What keeps the outside world out
# is the firewall: run-inference-proxy.sh prints the ufw rule that limits :PORT
# to the docker/OpenShell bridge ranges. Apply it, or bind a specific interface.
#
# Auth translation. NemoClaw's `inference` provider is OpenAI-compatible and
# always sends `Authorization: Bearer <key>` (from COMPATIBLE_API_KEY), but some
# lab gateways (Kong-style) authenticate ONLY on an `x-api-key` header and
# report "No API key found in request" on a Bearer one — the agent then dies on
# every LLM call with `401 status code (no body)` and the dashboard silently
# shows nothing, because lab-health's probe treats any <500 as healthy.
# So rewrite Bearer -> x-api-key for the upstream.
#
# The rewrite is CONDITIONAL on the caller already holding the key: this listener
# binds 0.0.0.0, and an unconditional `proxy_set_header x-api-key <key>` would
# make it lend the lab credential to callers that never had it. The map below
# matches the key in either incoming header; a caller that presented it gets the
# translated header, one that did not gets an empty x-api-key and the upstream's
# own 401 — i.e. exactly the access it has today.
# (With LLM_API_KEY unset the pattern degrades to matching an empty key, so the
# upstream still 401s; run-inference-proxy.sh's smoke test fails loudly on that.)
map "$http_authorization$http_x_api_key" $lab_key_${LLM_PROXY_PORT} {
    "~*${LLM_API_KEY}" "${LLM_API_KEY}";
    default            "";
}
#
# Buffering stays off: chat completions stream as long-lived SSE responses.

server {
    listen 127.0.0.1:${LLM_PROXY_PORT};
    listen ${BRIDGE_IP}:${LLM_PROXY_PORT};

    location /v1/ {
        proxy_pass ${LLM_BASE_URL}/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_ssl_server_name on;
        ${PROXY_SSL_CONF}
        # Translate the credential style; strip the Bearer form so the upstream
        # never sees a header it ignores. Setting a header to "" removes it.
        proxy_set_header x-api-key $lab_key_${LLM_PROXY_PORT};
        proxy_set_header Authorization "";
    }
}
