# Installed by: deploy/scripts/demo-browser.sh --install-autostart
#   → ~/.config/autostart/firefox.desktop
#
# Do NOT add X-GNOME-Autostart-Delay back. It is a GNOME 2 key that
# gnome-session on Ubuntu 24.04 ignores — measured 2026-10-13: session up at
# 10:47:33, browser started at 10:47:40 with `Delay=120` set, so the wait never
# happened and the dashboard loaded mid-boot and sat on a dead page (it does not
# retry). demo-browser.sh waits on /api/lab-health instead, which is the thing
# the delay was standing in for.
#
# Boot mode is substituted by the installer: `make install-demo-autostart` for a QA box
# (chrome + devtools), `make install-demo-autostart BOOT_MODE=kiosk` for a machine that
# should boot straight into the presentation. Edit __NEMOCLAW_BROWSER_MODE__ by hand in
# ~/.config/autostart/firefox.desktop and it works — but the repo no longer describes the
# host, which is the trap this layout hit twice on 2026-10-13 (the terminal unit, and the
# delay above). Re-run the installer instead.
[Desktop Entry]
Type=Application
Name=NemoClaw lab dashboard
Comment=Opens the lab dashboard once the lab reports healthy
Exec=__NEMOCLAW_REPO__/deploy/scripts/demo-browser.sh __NEMOCLAW_BROWSER_MODE__
Terminal=false
X-GNOME-Autostart-enabled=true
