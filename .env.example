# Copy to .env for local dev — never commit .env with real values

# Inference endpoint (OpenAI-compatible vLLM)
VLLM_BASE_URL=http://192.168.68.131:8000/v1
VLLM_API_KEY=vllm
VLLM_MODEL=qwen3.6-35b-a3b-dflash

# Internal service URLs (override for dev; defaults match docker-compose)
MCP_TOOLS_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8002
SIMULATOR_URL=http://localhost:8003
ORCHESTRATOR_URL=http://localhost:8004

# Active pack (controls which vertical runs)
PACK_ID=datacenter-xe9680

# State backend — SQLite path (dev) or Redis URL (prod)
# Dev:
SQLITE_PATH=./data/nemoclaw.db
# Prod (comment out SQLITE_PATH and set this instead):
# REDIS_URL=redis://:password@redis:6379/0

# Log level
LOG_LEVEL=INFO
