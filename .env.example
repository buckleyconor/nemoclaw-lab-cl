# Copy to .env for local dev — never commit .env with real values

# Inference endpoint (OpenAI-compatible with tool calling — the lab's shared
# endpoint, or your own vLLM). Consumed by the deploy scripts when onboarding /
# repointing the agent sandbox — the Compose stack itself never talks to the
# LLM (ADR-011). Values are BAKED into the sandbox at onboard: to move a live
# agent after editing them, run `make repoint-llm` (no rebuild); full reset:
# `make bootstrap FORCE=1`. The sandbox reaches the endpoint through the host
# inference proxy (ADR-014, deploy/scripts/run-inference-proxy.sh).
LLM_BASE_URL=http://YOUR_LLM_HOST:8000/v1
LLM_API_KEY=CHANGE_ME   # REQUIRED — the shared lab endpoint needs a real key
LLM_MODEL=qwen3.6-35b-a3b-fp8
# LLM_PROXY_PORT=18100  # host port of the inference proxy (ADR-014 default)
# LLM_DIRECT=1          # skip the proxy and bake LLM_BASE_URL verbatim — only
#                       # for a genuinely public-resolving endpoint (the
#                       # NemoClaw SSRF guard refuses private/internal hosts)

# Internal service URLs (for running services bare-metal on the host;
# defaults match docker-compose.yaml's published ports)
GATEWAY_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:8002
SIMULATOR_URL=http://localhost:8003
MCP_TOOLS_URL=http://localhost:8004

# Active pack (controls which vertical runs). Don't edit by hand mid-demo —
# use `make switch-pack PACK_ID=<id>` (or the lab guide's automatic switch),
# which updates this line and recreates the stack.
PACK_ID=datacenter-xe9680

# State backend — SQLite path (dev) or Redis URL (prod)
# Dev:
SQLITE_PATH=./data/nemoclaw.db
# Prod (comment out SQLITE_PATH and set this instead):
# REDIS_URL=redis://:password@redis:6379/0

# OpenClaw webhook wake-up (ADR-011) — the Gateway fires this the instant a
# fault is injected. The port is openclaw's webhook port: default 18789, but
# it silently self-reassigns if taken (18790 on the reference GB10 host) —
# ALWAYS confirm with `nemoclaw <sandbox> status` before setting. On Linux
# the containerized Gateway can't reach openshell's loopback-bound forward
# directly; `make hook-relay` bridges it onto the docker bridge IP
# (HOOK_RELAY_PORT env overrides its port if yours isn't 18790).
# OPENCLAW_HOOK_URL=http://host.docker.internal:18790
# OPENCLAW_HOOK_TOKEN=<printed by deploy/scripts/onboard-openclaw.sh>

# Embedded operator terminal (ADR-012) — optional, off unless configured.
# `make terminal` starts the host daemon, generates a token, and prints these
# two lines. NEVER enable in shared deployments (SPEC-EMBEDDED-TERMINAL.md §7).
# TERMINAL_WS_URL=ws://host.docker.internal:8005/ws
# TERMINAL_TOKEN=<generated by deploy/scripts/run-terminal.sh>
# TERMINAL_ENABLED=1   # set to 0 to force the feature off without unsetting the above
# TERMINAL_BIND=172.17.0.1   # docker bridge IP — loopback is unreachable from the
#                            # containerized gateway on Linux (see SPEC §4); with
#                            # ufw active, also allow the compose subnet (SPEC §6)
# SANDBOX_NAME=infra-sentinel  # which OpenClaw sandbox the restricted console
#                              # (TERMINAL_MODE=restricted) edits — used by
#                              # `make demo-up`; must match onboard-openclaw.sh

# Log level
LOG_LEVEL=INFO
