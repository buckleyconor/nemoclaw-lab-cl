# syntax=docker/dockerfile:1
# Backend image — used by: simulator, orchestrator, mcp-tools.
# Multi-arch: linux/arm64 (GB10 / MicroK8s dev) + linux/amd64 (prod).
# The [ml] dep group (fastembed + faiss-cpu) is installed here; on arm64 this
# requires onnxruntime-aarch64 wheels which are published since onnxruntime 1.18.

ARG PYTHON_VERSION=3.11
ARG UV_VERSION=0.5.11

# Named stage so ARG expansion works in --from (BuildKit limitation)
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# ── Stage 1: install dependencies into a virtualenv ───────────────────────────
FROM python:${PYTHON_VERSION}-slim AS deps

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

# Install system libs required by faiss-cpu / onnxruntime (libgomp)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_CACHE_DIR=/tmp/uv-cache

COPY pyproject.toml uv.lock ./
# Install all production deps + optional [ml] group into /app/.venv
RUN uv sync --frozen --no-dev --no-install-project --group ml


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the virtualenv from the deps stage
COPY --from=deps /app/.venv /app/.venv

# Copy application source
COPY libs/ libs/
COPY services/ services/
COPY packs/ packs/

# Activate the virtualenv for all subsequent commands
ENV VIRTUAL_ENV=/app/.venv \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

# Warm up fastembed model cache at build time so pod startup is instant.
# Model files land in /root/.cache/fastembed (~125 MB baked into image layer).
RUN python - <<'EOF'
try:
    from fastembed import TextEmbedding
    list(TextEmbedding("BAAI/bge-small-en-v1.5").embed(["warmup"]))
    print("fastembed model cached.")
except Exception as e:
    print(f"fastembed warmup skipped: {e}")
EOF

# Default: simulator. Override CMD in K8s / docker-compose per service.
EXPOSE 8003
CMD ["python", "-m", "uvicorn", "services.simulator.main:app", \
     "--host", "0.0.0.0", "--port", "8003"]
